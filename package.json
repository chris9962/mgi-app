{
  "name": "mgi-bank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "bun --env-file=.env.local x drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local scripts/db-migrate.ts",
    "db:seed": "bun --env-file=.env.local scripts/db-seed.ts",
    "db:create-admin": "bun --env-file=.env.local scripts/db-create-admin.ts",
    "test": "bun test tests/auth tests/config tests/unit",
    "test:db": "bun --env-file=.env.local test tests/db",
    "e2e": "bun --env-file=.env.local scripts/e2e-seed.ts && bunx playwright test; s=$?; bun --env-file=.env.local scripts/e2e-clean.ts; exit $s"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pg": "^8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
