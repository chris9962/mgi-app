DATABASE_URL=postgres://mgibank:mgibank@localhost:5434/mgibank
ADMIN_HOST=admin.localhost
STUDENT_HOST=bank.localhost

# S3: bucket riêng của mgi-bank. Máy local dùng mgi-bank-dev.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STUDENT_ORIGIN=http://bank.localhost:3100

# Khoá HMAC của 4 ký tự kiểm trong mã voucher. Thiếu khoá thì máy chủ không cấp voucher.
VOUCHER_SECRET=

# Python có PaddleOCR và VietOCR cho worker kiểm ảnh. Để trống thì test OCR thật bỏ qua.
OCR_PYTHON=
